{
  // Static site on Cloudflare Workers (static assets only, no Worker script).
  // `name` must match the Worker connected to this repo.
  "name": "ofc-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public"
  },
  // Required by `wrangler preview`, which Workers Builds runs for
  // non-production branches. Empty is fine; top-level settings apply.
  "previews": {}
}
